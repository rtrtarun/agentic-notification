{
  "name": "offline score tuning: feedback becomes bounded, explainable proposals; nothing is active until an admin approves; the heuristic's score and reason change only while an adjustment is active; critical feedback teaches nothing",
  "steps": [
    {
      "name": "adjustments need the key",
      "request": {
        "method": "GET",
        "path": "/api/learning/adjustments"
      },
      "expect": {
        "status": 401,
        "json": {
          "error": "missing or invalid api key"
        }
      }
    },
    {
      "name": "runs need the key",
      "request": {
        "method": "GET",
        "path": "/api/learning/runs"
      },
      "expect": {
        "status": 401,
        "json": {
          "error": "missing or invalid api key"
        }
      }
    },
    {
      "name": "there is nothing yet, and the limits in force are shown",
      "request": {
        "method": "GET",
        "path": "/api/learning/adjustments",
        "headers": {
          "X-API-Key": "contract-key"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "adjustments": [],
          "version": 0,
          "maxAdjustment": 20,
          "minSignals": 5,
          "minPeople": 1
        }
      }
    },
    {
      "name": "no run has been made, and none is scheduled",
      "request": {
        "method": "GET",
        "path": "/api/learning/runs",
        "headers": {
          "X-API-Key": "contract-key"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "runs": [],
          "every": "0s"
        }
      }
    },
    {
      "name": "an unknown status is refused",
      "request": {
        "method": "GET",
        "path": "/api/learning/adjustments?status=maybe",
        "headers": {
          "X-API-Key": "contract-key"
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "error": "status must be proposed, active, rejected or retired"
        }
      }
    },
    {
      "name": "adjustments cannot be written to",
      "request": {
        "method": "PUT",
        "path": "/api/learning/adjustments",
        "headers": {
          "X-API-Key": "contract-key"
        },
        "body": {}
      },
      "expect": {
        "status": 405,
        "json": {
          "error": "method not allowed"
        }
      }
    },
    {
      "name": "runs cannot be deleted",
      "request": {
        "method": "DELETE",
        "path": "/api/learning/runs",
        "headers": {
          "X-API-Key": "contract-key"
        }
      },
      "expect": {
        "status": 405,
        "json": {
          "error": "method not allowed"
        }
      }
    },
    {
      "name": "a run has no sub-path",
      "request": {
        "method": "GET",
        "path": "/api/learning/runs/abc",
        "headers": {
          "X-API-Key": "contract-key"
        }
      },
      "expect": {
        "status": 404,
        "json": {
          "error": "not found"
        }
      }
    },
